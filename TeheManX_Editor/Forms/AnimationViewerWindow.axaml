<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="using:TeheManX_Editor.Forms"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		x:Class="TeheManX_Editor.Forms.AnimationViewerWindow"
		Title="Enemy Animation Viewer"
		Width="520" Height="475"
		WindowStartupLocation="CenterOwner"
		Background="#1E1E1E">
	<Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="10">
		<!-- Header info -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
			<TextBlock x:Name="infoText" FontFamily="Consolas" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
			<CheckBox x:Name="originCheck" Content="Show Origin" IsChecked="False" Foreground="White" Checked="originCheck_Enable" Unchecked="originCheck_Disable"/>
		</StackPanel>
		<!-- Tile and palette selector -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
			<TextBlock Text="Tile ID:" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center"/>
			<local:NumInt x:Name="tileIdInt" Width="65" Height="28" FontSize="16" Minimum="0" Maximum="220" ValueChanged="OverrideInt_ValueChanged"/>

			<TextBlock Text="Palette ID:" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
			<local:NumInt x:Name="palIdInt" Width="75" Height="28" FontSize="16" Minimum="0" Maximum="510" ValueChanged="OverrideInt_ValueChanged"/>

			<Button x:Name="resetBtn" Content="Reset" Height="28" Click="resetBtn_Click"/>
			<Button x:Name="exportBtn" Content="Export Sheet" Height="28" Margin="8,0,0,0" Click="exportBtn_Click"/>
		</StackPanel>

		<!-- Sprite canvas -->
		<Border Grid.Row="2" BorderBrush="#444444" BorderThickness="1" Background="#252526">
			<local:SkiaControl x:Name="previewCanvas" RenderEvent="previewCanvas_RenderEvent" MeasureEvent="previewCanvas_MeasureEvent"/>
		</Border>

		<!-- Frame scrubber -->
		<Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,6">
			<TextBlock Grid.Column="0" Text="Frame:" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<Slider x:Name="frameSlider" Grid.Column="1" Minimum="0" Maximum="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="frameSlider_ValueChanged"/>
			<TextBlock x:Name="frameLabel" Grid.Column="2" Text="0 / 0" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" Margin="8,0,0,0"/>
		</Grid>

		<!-- Playback controls -->
		<StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
			<Button x:Name="prevBtn" Content="&lt; Prev" Width="65" Click="prevBtn_Click"/>
			<Button x:Name="playBtn" Content="Pause" Width="70" Click="playBtn_Click"/>
			<Button x:Name="nextBtn" Content="Next &gt;" Width="65" Click="nextBtn_Click"/>
			<TextBlock Text="Speed:" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
			<ComboBox x:Name="fpsCombo" Width="75" SelectedIndex="2" SelectionChanged="fpsCombo_SelectionChanged">
				<ComboBoxItem Content="4"/>
				<ComboBoxItem Content="8"/>
				<ComboBoxItem Content="12"/>
				<ComboBoxItem Content="20"/>
				<ComboBoxItem Content="30"/>
				<ComboBoxItem Content="60"/>
			</ComboBox>
			<TextBlock Text="Zoom:" FontFamily="Consolas" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0"/>
			<ComboBox x:Name="zoomCombo" Width="65" SelectedIndex="2" SelectionChanged="OnRedrawOptionChanged">
				<ComboBoxItem Content="1x"/>
				<ComboBoxItem Content="2x"/>
				<ComboBoxItem Content="3x"/>
				<ComboBoxItem Content="4x"/>
			</ComboBox>
		</StackPanel>
	</Grid>
</Window>
